{
  "name": "historicmap",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Atlas temporal de la Tierra, su geografía y sus sociedades",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-country-catalog.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "data:fetch:modern": "node scripts/fetch-modern.mjs",
    "data:audit": "node scripts/build-review.mjs",
    "entities:prepare": "node scripts/prepare-country-catalog.mjs"
  },
  "dependencies": {
    "lucide": "1.61.0",
    "maplibre-gl": "6.15.0",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
