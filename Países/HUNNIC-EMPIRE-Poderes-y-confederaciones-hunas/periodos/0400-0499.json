  "institutions": [
    {
      "id": "review036-attila",
      "type": "institution",
      "title": "Agrupaciones hunas, corregencia y disolución",
      "start": "0400-01-01",
      "end": "0470-01-01",
      "text": "Bleda yAttila comparten autoridad aproximadamente434–445. La confederación se fragmenta tras453–454; los ámbitos posteriores no se pintan como un imperio unitario continuo ni como una población homogénea.",
      "source": "https://lex.dk/Attila",
      "sourceLabel": "Referencia documental · siglo V",
      "precision": 9,
      "note": "Contexto parcial y localización regional; no inventario completo de conflictos ni fronteras observadas diariamente.",
      "section": "institutions"
